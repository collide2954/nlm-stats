{
  "name": "nlm-stats",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html",
    "test": "npm run lint && node --test \"tests/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "snapshot": "node scripts/snapshot.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "html-validate": "^11.18.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
